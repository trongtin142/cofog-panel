# Launch scripts keep the line endings of their platform in every checkout (a CRLF in run_gui.sh stops bash)
*.sh text eol=lf
*.bat text eol=crlf

# Third-party data of replication/environment are stored byte for byte: fetch_data.py checks them against SHA-256
replication/environment/data_ext/lab/** -text
replication/environment/data_ext/*.json -text
replication/environment/data_ext/CHECKSUMS_r5i.sha256 -text

# Distributed data whose SHA-256 is recorded (data/sample/README.md, replication/harmonisation/data_ext/SOURCES.md)
data/sample/*.csv -text
replication/harmonisation/data_ext/*.csv -text
